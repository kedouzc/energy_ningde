  {
    "key": "watch",
    "value": [
      {
        "id": "hdt_electrification",
        "layer": "重卡·电动化",
        "group": "重卡·电动化（累计锚 / 单月边际两副眼镜）",
        "role": "累计口径 · 曲线重标锚",
        "model": "vehicles.heavy.nev_anchor_rate",
        "observed": "重卡.latest_nev_pen_cum",
        "unit": "%",
        "decimals": 1,
        "compare": "diff",
        "threshold": 0.03,
        "direction": "model_low",
        "period": "月度",
        "why": "实测高出拟合锚，说明曲线该重标——**改锚即可，k/t0 自动重算**，不要手改 nev_rates"
      },
      {
        "id": "hdt_swap_share",
        "layer": "重卡·换电占纯电",
        "group": "重卡·换电占纯电（累计锚 / 单月边际两副眼镜）",
        "role": "累计口径 · 趋势确认锚",
        "model": "calc:heavy_swap_penetration_weighted",
        "observed": "重卡.latest_swap_share_cum",
        "unit": "%",
        "decimals": 1,
        "compare": "diff",
        "threshold": 0.1,
        "direction": "either",
        "period": "月度",
        "why": "模型假设它会从实测水平反转回升。**这不是 bug，是一个反转预期**——三条推翻条件写在 swap_penetration 声明段，机制与三条反驳见 topics/竞争格局「换电占电动为什么在跌」"
      },
      {
        "id": "private_pool_path",
        "layer": "私家车池·增长路径",
        "model": "vehicles.private.annual_net_additions_wan.0",
        "observed": "乘用车.bev_annualized_wan",
        "unit": "万辆",
        "decimals": 1,
        "compare": "ratio",
        "threshold": 1.6,
        "direction": "model_high",
        "period": "月度",
        "why": "**净增是存量增量、销量是流量，净增不可能超过销量。** 口径本身没问题（私家车池分母取公安部纯电保有量口径，已排除插混），要核的是这条增长路径的依据。影响量化见沙盘②「私家车敏感性」"
      },
      {
        "id": "service_fee",
        "layer": "经营·换电服务费",
        "model": "swap_business.service_fee_rmb_kwh",
        "observed": "",
        "unit": "元/kWh",
        "decimals": 2,
        "compare": "diff",
        "threshold": 0.05,
        "direction": "model_high",
        "period": "月度",
        "why": "**数据源未接。** 它是经济门的翻转轴之一（跌到某个价门就红），且是「换电占电动为什么在跌」那条假说的三重角色指标。接入前这张卡只起登记作用——**空着比没有好，因为空着是看得见的**"
